
<Window x:Class="CyberCacti.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Cacti"
        Height="800"
        Width="1200"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CreamBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource ForestBrush}">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="🌵 CYBER CACTI"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="Bold"
                               Margin="0,15,0,35"/>

                    <Button Content="Home" Tag="Home"
                            Click="Navigate_Click" Margin="0,5"/>
                    <Button Content="Dashboard" Tag="Dashboard"
                            Click="Navigate_Click" Margin="0,5"/>
                    <Button Content="About Us" Tag="About Us"
                            Click="Navigate_Click" Margin="0,5"/>
                    <Button Content="Hedgehogs" Tag="Hedgehogs"
                            Click="Navigate_Click" Margin="0,5"/>
                    <Button Content="How to Help" Tag="How to Help"
                            Click="Navigate_Click" Margin="0,5"/>
                    <Button Content="More" Tag="More"
                            Click="Navigate_Click" Margin="0,5"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Protect. Preserve. Inspire."
                           Foreground="#DCE8D9"
                           FontSize="12"
                           TextAlignment="Center"
                           Margin="0,20"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle"
                       Text="Welcome to Cyber Cacti"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource ForestBrush}"
                       Margin="0,10,0,25"/>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="22"
                    Padding="35">

                <Grid>

                    <!-- Standard page content -->
                    <StackPanel x:Name="StandardPanel"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="PageHeading"
                                   Text="Protecting hedgehogs, one step at a time."
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ForestBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <TextBlock x:Name="PageDescription"
                                   Text="Welcome to Cyber Cacti! Explore our project, discover fascinating hedgehog facts and learn how you can help protect these wonderful animals."
                                   FontSize="17"
                                   Foreground="#58665C"
                                   TextWrapping="Wrap"
                                   LineHeight="28"/>

                        <Button Content="Explore the project"
                                Width="190"
                                HorizontalAlignment="Left"
                                Margin="0,30,0,0"
                                Click="Explore_Click"/>
                    </StackPanel>

                    <!-- How to Help checklist -->
                    <ScrollViewer x:Name="HelpPanel"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">

                        <StackPanel>
                            <TextBlock Text="Small actions. Big difference."
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ForestBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Tick each action as you complete it. Your progress is saved on this computer."
                                       FontSize="15"
                                       Foreground="#58665C"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,22"/>

                            <TextBlock x:Name="ProgressText"
                                       Text="0 out of 5 actions completed"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ForestBrush}"
                                       Margin="0,0,0,10"/>

                            <ProgressBar x:Name="ProgressBarControl"
                                         Minimum="0"
                                         Maximum="5"
                                         Value="0"
                                         Height="14"
                                         Margin="0,0,0,25"/>

                            <CheckBox x:Name="Action1"
                                      Content="Check that hedgehogs can move between gardens"
                                      FontSize="16"
                                      Margin="0,10"
                                      Checked="Checklist_Changed"
                                      Unchecked="Checklist_Changed"/>

                            <CheckBox x:Name="Action2"
                                      Content="Keep a shallow dish of fresh water available"
                                      FontSize="16"
                                      Margin="0,10"
                                      Checked="Checklist_Changed"
                                      Unchecked="Checklist_Changed"/>

                            <CheckBox x:Name="Action3"
                                      Content="Check long grass carefully before mowing"
                                      FontSize="16"
                                      Margin="0,10"
                                      Checked="Checklist_Changed"
                                      Unchecked="Checklist_Changed"/>

                            <CheckBox x:Name="Action4"
                                      Content="Keep garden spaces safe and free of litter"
                                      FontSize="16"
                                      Margin="0,10"
                                      Checked="Checklist_Changed"
                                      Unchecked="Checklist_Changed"/>

                            <CheckBox x:Name="Action5"
                                      Content="Learn more about hedgehog conservation"
                                      FontSize="16"
                                      Margin="0,10"
                                      Checked="Checklist_Changed"
                                      Unchecked="Checklist_Changed"/>

                            <Button Content="Reset progress"
                                    Width="160"
                                    HorizontalAlignment="Left"
                                    Margin="0,30,0,10"
                                    Click="ResetProgress_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
