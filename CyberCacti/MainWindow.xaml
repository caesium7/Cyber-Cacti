
<Window x:Class="CyberCacti.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Cacti"
        Height="800"
        Width="1200"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CreamBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource ForestBrush}">
            <DockPanel Margin="20">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="🌵 CYBER CACTI"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="Bold"
                               Margin="0,15,0,35"/>

                    <Button Content="Home" Tag="Home"
                            Click="Navigate_Click" Margin="0,5"/>
                    <Button Content="Dashboard" Tag="Dashboard"
                            Click="Navigate_Click" Margin="0,5"/>
                    <Button Content="About Us" Tag="About Us"
                            Click="Navigate_Click" Margin="0,5"/>
                    <Button Content="Hedgehogs" Tag="Hedgehogs"
                            Click="Navigate_Click" Margin="0,5"/>
                    <Button Content="How to Help" Tag="How to Help"
                            Click="Navigate_Click" Margin="0,5"/>
                    <Button Content="More" Tag="More"
                            Click="Navigate_Click" Margin="0,5"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Protect. Preserve. Inspire."
                           Foreground="#DCE8D9"
                           FontSize="12"
                           TextAlignment="Center"
                           Margin="0,20"/>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle"
                       Text="Welcome to Cyber Cacti"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource ForestBrush}"
                       Margin="0,10,0,25"/>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="22"
                    Padding="35">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageHeading"
                               Text="Protecting hedgehogs, one step at a time."
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="{StaticResource ForestBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="PageDescription"
                               Text="Welcome to Cyber Cacti! Explore our project, discover fascinating hedgehog facts and learn how you can help protect these wonderful animals."
                               FontSize="17"
                               Foreground="#58665C"
                               TextWrapping="Wrap"
                               LineHeight="28"/>

                    <Button Content="Explore the project"
                            Width="190"
                            HorizontalAlignment="Left"
                            Margin="0,30,0,0"
                            Click="Explore_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
