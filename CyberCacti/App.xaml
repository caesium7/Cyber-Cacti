
<Application x:Class="CyberCacti.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <Color x:Key="ForestGreen">#315B45</Color>
        <Color x:Key="SageGreen">#DCE8D9</Color>
        <Color x:Key="Cream">#F7F5EC</Color>
        <Color x:Key="WarmGold">#D6AD57</Color>

        <SolidColorBrush x:Key="ForestBrush"
                         Color="{StaticResource ForestGreen}"/>
        <SolidColorBrush x:Key="SageBrush"
                         Color="{StaticResource SageGreen}"/>
        <SolidColorBrush x:Key="CreamBrush"
                         Color="{StaticResource Cream}"/>
        <SolidColorBrush x:Key="GoldBrush"
                         Color="{StaticResource WarmGold}"/>

        <Style TargetType="Button">
            <Setter Property="Background"
                    Value="{StaticResource ForestBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
