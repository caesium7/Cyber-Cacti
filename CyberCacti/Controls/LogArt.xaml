<UserControl x:Class="CyberCacti.Controls.LogArt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Canvas Width="48" Height="28">
            <Rectangle Width="48" Height="24" Canvas.Top="2" RadiusX="10" RadiusY="10" Fill="#7A5840"/>
            <Ellipse Canvas.Left="2" Canvas.Top="4" Width="16" Height="20" Fill="#C4A07A"/>
            <Ellipse Canvas.Left="6" Canvas.Top="8" Width="8" Height="12" Fill="#A07A58"/>
            <Ellipse Canvas.Left="8" Canvas.Top="10" Width="4" Height="8" Fill="#7A5840"/>
            <Path Stroke="#5C4030" StrokeThickness="1.4" Data="M22,8 C28,12 34,10 42,14"/>
            <Path Stroke="#5C4030" StrokeThickness="1.2" Data="M24,16 C30,18 36,16 44,18"/>
        </Canvas>
    </Viewbox>
</UserControl>
