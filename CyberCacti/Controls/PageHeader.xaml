<UserControl x:Class="CyberCacti.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,8">
        <TextBlock x:Name="TitleBlock" Style="{StaticResource TitleText}"/>
        <TextBlock x:Name="SubtitleBlock" Style="{StaticResource SubtitleText}"/>
        <Border Style="{StaticResource GoldRule}"/>
    </StackPanel>
</UserControl>
