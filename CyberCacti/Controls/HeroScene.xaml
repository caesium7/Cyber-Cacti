<UserControl x:Class="CyberCacti.Controls.HeroScene"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CyberCacti.Controls">
    <Grid>
        <Border Background="#1F4636" CornerRadius="20" ClipToBounds="True"/>
        <Ellipse Width="128" Height="128"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-24,-20,0"
                 Fill="#C79A4A" Opacity="0.88"/>
        <Ellipse Width="260" Height="100"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,-40"
                 Fill="#16382C"/>
        <Grid Margin="16,20,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition Width="0.6*"/>
            </Grid.ColumnDefinitions>
            <controls:CactusArt Grid.Column="0"
                                Width="72"
                                Height="112"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"/>
            <controls:HedgehogArt Grid.Column="1"
                                  Width="148"
                                  Height="98"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</UserControl>
