<UserControl x:Class="CyberCacti.Controls.HedgehogArt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Canvas Width="180" Height="120">
            <!-- Shadow -->
            <Ellipse Canvas.Left="28" Canvas.Top="96" Width="118" Height="16"
                     Fill="#1A000000"/>

            <!-- Spike mass -->
            <Path Fill="#4A372C">
                <Path.Data>
                    <PathGeometry Figures="M38,62
                        C30,48 36,32 52,24
                        L48,10 L62,20
                        L66,6 L76,20
                        L86,4 L94,20
                        L108,6 L112,22
                        L128,12 L124,28
                        C142,32 154,48 148,66
                        C152,82 136,94 112,92
                        C96,102 72,102 54,90
                        C36,88 28,76 38,62 Z"/>
                </Path.Data>
            </Path>

            <!-- Inner spike tint -->
            <Path Fill="#5C4638" Opacity="0.9">
                <Path.Data>
                    <PathGeometry Figures="M48,64
                        C44,50 54,36 70,34
                        C82,28 98,30 110,38
                        C126,42 134,56 128,70
                        C124,82 108,88 90,86
                        C72,92 54,84 48,64 Z"/>
                </Path.Data>
            </Path>

            <!-- Face -->
            <Ellipse Canvas.Left="96" Canvas.Top="44" Width="68" Height="50"
                     Fill="#E8C39A"/>
            <Ellipse Canvas.Left="108" Canvas.Top="36" Width="16" Height="16"
                     Fill="#D7A57C"/>
            <Ellipse Canvas.Left="111" Canvas.Top="40" Width="8" Height="8"
                     Fill="#F0C8B0"/>

            <!-- Eye -->
            <Ellipse Canvas.Left="136" Canvas.Top="58" Width="9" Height="9"
                     Fill="#1C241F"/>
            <Ellipse Canvas.Left="138.5" Canvas.Top="59.5" Width="3.2" Height="3.2"
                     Fill="#F7F3EA"/>

            <!-- Nose -->
            <Ellipse Canvas.Left="152" Canvas.Top="70" Width="12" Height="9"
                     Fill="#2C241C"/>

            <!-- Smile -->
            <Path Stroke="#A87858" StrokeThickness="1.6" StrokeStartLineCap="Round"
                  Data="M138,78 Q146,84 154,78"/>

            <!-- Chest -->
            <Ellipse Canvas.Left="70" Canvas.Top="70" Width="48" Height="28"
                     Fill="#C4A07A"/>

            <!-- Paws -->
            <Ellipse Canvas.Left="62" Canvas.Top="88" Width="18" Height="12"
                     Fill="#C9A17C"/>
            <Ellipse Canvas.Left="96" Canvas.Top="90" Width="18" Height="12"
                     Fill="#C9A17C"/>
        </Canvas>
    </Viewbox>
</UserControl>
