<UserControl x:Class="CyberCacti.Controls.CactusArt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Canvas Width="90" Height="140">
            <!-- Pot -->
            <Path Fill="#C4845A">
                <Path.Data>
                    <PathGeometry Figures="M22,108 L68,108 L62,136 L28,136 Z"/>
                </Path.Data>
            </Path>
            <Rectangle Canvas.Left="18" Canvas.Top="102" Width="54" Height="10"
                       RadiusX="3" RadiusY="3" Fill="#B6754C"/>

            <!-- Main stem -->
            <Rectangle Canvas.Left="34" Canvas.Top="18" Width="22" Height="88"
                       RadiusX="11" RadiusY="11" Fill="#5E9A64"/>
            <Rectangle Canvas.Left="38" Canvas.Top="26" Width="4" Height="72"
                       RadiusX="2" RadiusY="2" Fill="#76B07A" Opacity="0.55"/>

            <!-- Left arm -->
            <Rectangle Canvas.Left="16" Canvas.Top="48" Width="28" Height="12"
                       RadiusX="6" RadiusY="6" Fill="#5E9A64"/>
            <Rectangle Canvas.Left="16" Canvas.Top="28" Width="12" Height="32"
                       RadiusX="6" RadiusY="6" Fill="#5E9A64"/>

            <!-- Right arm -->
            <Rectangle Canvas.Left="46" Canvas.Top="62" Width="26" Height="12"
                       RadiusX="6" RadiusY="6" Fill="#5E9A64"/>
            <Rectangle Canvas.Left="60" Canvas.Top="46" Width="12" Height="28"
                       RadiusX="6" RadiusY="6" Fill="#5E9A64"/>

            <!-- Flower -->
            <Ellipse Canvas.Left="38" Canvas.Top="6" Width="14" Height="14" Fill="#C79A4A"/>
            <Ellipse Canvas.Left="41" Canvas.Top="9" Width="8" Height="8" Fill="#E8C56A"/>
        </Canvas>
    </Viewbox>
</UserControl>
