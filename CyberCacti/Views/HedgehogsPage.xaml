<UserControl x:Class="CyberCacti.Views.HedgehogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CyberCacti.Controls">
    <StackPanel>
        <controls:PageHeader Title="Meet the Hedgehogs"
                             Subtitle="Night-time visitors that rely on connected gardens."/>

        <Border Background="{StaticResource PaleBrush}"
                CornerRadius="20"
                Padding="22"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Getting to know hedgehogs" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource BodyText}"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,8,0,0"
                               Text="Hedgehogs are mostly active after dark. They use gardens, parks and hedgerows to find beetles, worms and a safe place to rest."/>
                </StackPanel>
                <controls:HedgehogArt Grid.Column="1" Height="110"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Where do they live?" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                           Text="They travel through gardens, woodland edges, parks and hedgerows. Gaps between fences matter because one garden is rarely enough — they need a connected neighbourhood."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="What dangers do they face?" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,8"
                           Text="Everyday garden features can be dangerous if they are left unchecked:"/>
                <TextBlock Style="{StaticResource BodyText}"
                           Text="• Uncovered drains, ponds and steep-sided holes&#x0a;• Loose netting, football nets and litter&#x0a;• Mowers, strimmers and garden machinery&#x0a;• Solid fences with no way through&#x0a;• Nowhere quiet to nest or hibernate"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="How can we protect them?" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,14"
                           Text="Look before you cut or mow, keep netting off the ground, offer a shallow dish of water, and leave a wild corner with leaves or logs. The five-action checklist turns those habits into a simple plan."/>
                <Button Style="{StaticResource PrimaryButton}"
                        Content="See the full action checklist"
                        HorizontalAlignment="Left"
                        Click="Checklist_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
