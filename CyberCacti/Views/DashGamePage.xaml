<UserControl x:Class="CyberCacti.Views.DashGamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CyberCacti.Controls">
    <StackPanel>
        <controls:PageHeader Title="Hedgehog Dash"
                             Subtitle="Collect apples, dodge logs and see how far you can run."/>

        <Border Style="{StaticResource CardBorder}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SCORE" Style="{StaticResource EyebrowText}"/>
                    <TextBlock x:Name="ScoreText" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource ForestBrush}" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="LIVES" Style="{StaticResource EyebrowText}"/>
                    <StackPanel x:Name="LivesPanel" Orientation="Horizontal" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="PERSONAL BEST" Style="{StaticResource EyebrowText}"/>
                    <TextBlock x:Name="BestText" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource ForestBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="InfoText"
                   Style="{StaticResource BodyText}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource MutedBrush}"
                   Margin="0,0,0,10"
                   Text="Ready when you are — press start to play."/>

        <Border CornerRadius="20"
                BorderBrush="#C9D6C4"
                BorderThickness="1"
                ClipToBounds="True"
                Margin="0,0,0,12">
            <Canvas x:Name="GameCanvas"
                    Height="420"
                    Focusable="True"
                    ClipToBounds="True"
                    Background="#8FAE78"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
            <Button Content="Left" Click="Left_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Start / Restart" Click="Start_Click"/>
            <Button Content="Right" Click="Right_Click"/>
        </StackPanel>

        <TextBlock Style="{StaticResource BodyText}"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Use the left and right arrow keys, A and D, or the buttons to change lanes. Collect apples and avoid logs."/>
    </StackPanel>
</UserControl>
