<UserControl x:Class="CyberCacti.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CyberCacti.Controls">
    <StackPanel>
        <controls:PageHeader Title="Your Dashboard"
                             Subtitle="A snapshot of your Cyber Cacti journey."/>

        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ACTIONS COMPLETED" Style="{StaticResource EyebrowText}"/>
                    <TextBlock x:Name="ActionsValue"
                               FontSize="36"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ForestBrush}"/>
                    <TextBlock Text="Out of 5 suggested actions"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="GAME HIGH SCORE" Style="{StaticResource EyebrowText}"/>
                    <TextBlock x:Name="ScoreValue"
                               FontSize="36"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ForestBrush}"/>
                    <TextBlock Text="Your best Dash Game result"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Your impact" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="ImpactLabel" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ProgressBar x:Name="ProgressBar"/>
                <TextBlock x:Name="ImpactHint"
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,12"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Open my checklist"
                        HorizontalAlignment="Left"
                        Click="Checklist_Click"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <Border Style="{StaticResource PillBorder}" Background="#F6EEDC" Margin="0,0,0,10">
                    <TextBlock Text="Did you know?"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource GoldBrush}"/>
                </Border>
                <TextBlock Text="Hedgehogs are night explorers" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                           Text="Hedgehogs are nocturnal. They usually come out after dusk to search for food and move between gardens, parks and hedgerows."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Your next mission" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource BodyText}"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,0"
                           Text="Pick one wildlife-friendly action this week. A fence gap, a water dish or a quieter corner of the garden can all help."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
