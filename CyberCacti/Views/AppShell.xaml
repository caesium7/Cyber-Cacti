<UserControl x:Class="CyberCacti.Views.AppShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CyberCacti.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="{StaticResource DeepForestBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="22,28,18,20">
                <TextBlock Text="CYBER CACTI"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock Text="HEDGEHOG AWARENESS"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#BFD0C1"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NavPanel" Margin="12,0,12,8">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="MainNav" Tag="Home" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavGlyph Kind="Home" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Home" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="MainNav" Tag="Dashboard" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavGlyph Kind="Dashboard" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="MainNav" Tag="About Us" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavGlyph Kind="About Us" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="About Us" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="MainNav" Tag="Hedgehogs" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavGlyph Kind="Hedgehogs" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Hedgehogs" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="MainNav" Tag="How to Help" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavGlyph Kind="How to Help" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="How to Help" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="MainNav" Tag="More" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavGlyph Kind="More" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="More" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="MainNav" Tag="Innovation Project" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavGlyph Kind="Innovation Project" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Innovation Project" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="MainNav" Tag="Contact Us" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavGlyph Kind="Contact Us" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Contact Us" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="MainNav" Tag="Dash Game" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavGlyph Kind="Dash Game" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Dash Game" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#214536"
                    CornerRadius="16"
                    Padding="14"
                    Margin="12,8,12,16">
                <StackPanel>
                    <TextBlock Text="SIGNED IN AS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#BFD0C1"/>
                    <TextBlock x:Name="UserNameText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,2,0,10"/>
                    <Button Content="Sign out" Click="SignOut_Click" Margin="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Background="{StaticResource CreamBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource WhiteBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,16">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YOUR HEDGEHOG CONSERVATION SPACE"
                                   Style="{StaticResource EyebrowText}"/>
                        <TextBlock x:Name="WelcomeText"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForestBrush}"/>
                    </StackPanel>
                    <Border Style="{StaticResource PillBorder}"
                            Background="{StaticResource PaleBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="Local profile"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForestBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="28,24">
                <ContentControl x:Name="PageHost" MaxWidth="1120" HorizontalAlignment="Stretch"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
