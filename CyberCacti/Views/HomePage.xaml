<UserControl x:Class="CyberCacti.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CyberCacti.Controls">
    <StackPanel>
        <Border Background="{StaticResource DeepForestBrush}"
                CornerRadius="24"
                Padding="28"
                Margin="0,0,0,20"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Style="{StaticResource PillBorder}" Margin="0,0,0,12">
                        <TextBlock Text="Welcome to Cyber Cacti"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForestBrush}"/>
                    </Border>
                    <TextBlock Text="Small actions.&#x0a;Big impact."
                               FontSize="36"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Help hedgehogs thrive by making everyday outdoor spaces safer."
                               FontSize="15"
                               Foreground="#D9E5D9"
                               TextWrapping="Wrap"
                               Margin="0,10,0,16"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Explore how to help"
                            HorizontalAlignment="Left"
                            Click="Help_Click"/>
                </StackPanel>
                <controls:HeroScene Grid.Column="1" Height="210"/>
            </Grid>
        </Border>

        <controls:PageHeader Title="Your conservation journey"
                             Subtitle="Every small step can make a difference."/>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="YOUR PROGRESS" Style="{StaticResource EyebrowText}"/>
                <TextBlock x:Name="ProgressLabel"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ForestBrush}"
                           Margin="0,4,0,0"/>
                <ProgressBar x:Name="ProgressBar"/>
                <TextBlock x:Name="ProgressHint" Style="{StaticResource BodyText}"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Explore hedgehogs" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Discover their habits, habitats and the challenges they face."
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,6,0,12"/>
                    <Button Content="Meet the hedgehogs" Click="Hedgehogs_Click" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Your dashboard" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="See your completed actions and personal best in Hedgehog Dash."
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,6,0,12"/>
                    <Button Content="View dashboard" Click="Dashboard_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
